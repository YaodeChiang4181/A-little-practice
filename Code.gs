const SHEET_NAME = "表單回應";
function sheet_(){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(SHEET_NAME);if(!sh)throw new Error("找不到工作表："+SHEET_NAME);return sh;}
function json_(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON);}
function row_(sh,id){const n=sh.getLastRow();if(n<2)return -1;const v=sh.getRange(2,2,n-1,1).getDisplayValues();for(let i=0;i<v.length;i++)if(String(v[i][0]).trim()===String(id).trim())return i+2;return -1;}
function group_(g){return g==='A'?'A 組 - 總體經濟與市場策略':g+' 組';}
function valid_(d){if(!d.studentId||!d.studentName||!d.email)throw new Error('請完整填寫必填欄位');if(!['A','B','C'].includes(d.group))throw new Error('請選擇分組');if(!d.consent)throw new Error('請確認出席與通知同意');}
function doPost(e){try{const d=JSON.parse(e.postData.contents||'{}'),sh=sheet_();if(d.action==='create'){valid_(d);if(row_(sh,d.studentId)!==-1)return json_({success:false,message:'此學號已經報名'});sh.appendRow([Utilities.formatDate(new Date(),'Asia/Taipei','yyyy/MM/dd HH:mm:ss'),d.studentId.trim(),d.studentName.trim(),d.email.trim(),group_(d.group),'已確認可準時出席並同意接收相關教材資料']);return json_({success:true});}if(d.action==='update'){valid_(d);const r=row_(sh,d.studentId);if(r===-1)return json_({success:false,message:'找不到報名資料'});sh.getRange(r,3,1,4).setValues([[d.studentName.trim(),d.email.trim(),group_(d.group),'已確認可準時出席並同意接收相關教材資料']]);return json_({success:true});}if(d.action==='delete'){const r=row_(sh,d.studentId);if(r===-1)return json_({success:false,message:'找不到報名資料'});sh.deleteRow(r);return json_({success:true});}return json_({success:false,message:'未知操作'});}catch(err){return json_({success:false,message:err.message});}}
function doGet(e){try{const sh=sheet_(),id=(e.parameter.studentId||'').trim();if(id){const r=row_(sh,id);if(r===-1)return json_({success:false,message:'查無資料'});const v=sh.getRange(r,1,1,6).getDisplayValues()[0];return json_({success:true,data:{timestamp:v[0],studentId:v[1],studentName:v[2],email:v[3],group:v[4],consent:v[5]}});}return json_({success:true,message:'API is running'});}catch(err){return json_({success:false,message:err.message});}}
